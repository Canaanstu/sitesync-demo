# No real keys are needed in demo mode. Copy this file to .env.
APP_ENV=development
DEMO_MODE=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DATABASE_URL=sqlite:///.local/construction.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/construction_ai
REDIS_URL=redis://localhost:6379/0
# Empty values generate local secrets; set explicit generated values for live/shared deployments.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_BASE_URL=https://api.procore.com
PROCORE_LOGIN_URL=https://login.procore.com
# Redirect is derived from API_URL + /api/integrations/procore/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_SCOPES=openid profile offline_access User.Read Mail.Read Files.Read.All Sites.Read.All
# Optional reviewed email sending: set true and add Mail.Send to MICROSOFT_SCOPES,
# then reconnect Microsoft to consent. Demo mode always simulates sending.
ENABLE_EMAIL_SEND=false
# Redirect is derived from API_URL + /api/integrations/microsoft/callback
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# First administrator in an empty live database; set these before the first startup.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
